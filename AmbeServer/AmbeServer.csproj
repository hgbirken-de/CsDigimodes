<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="AmbeServerConfig.yaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AmbeServerConfig.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <SubType>Component</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NLog" Version="6.0.6" />
    <PackageReference Include="System.IO.Ports" Version="9.0.7" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalVoice.AmbeSupport\DigitalVoice.AmbeSupport.csproj" />
    <ProjectReference Include="..\DigitalVoice.AudioSupport\DigitalVoice.AudioSupport.csproj" />
    <ProjectReference Include="..\DigitalVoice.Common\DigitalVoice.Common.csproj" />
  </ItemGroup>

</Project>
