<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
             x:Class="DigitalVoiceControlApp.Views.DmrModeControl">

  <StackPanel Orientation="Vertical" Spacing="5">

    <!-- Gruppierter Block: CALL/TA, SRC/DST, RPT - gemeinsam zentriert -->
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Background="#EAF3FB" Padding="10" HorizontalAlignment="Center" Width="400">
      <StackPanel Orientation="Vertical" Spacing="5" >

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="CALL" VerticalAlignment="Center" Width="35"/>
          <TextBox Focusable="False" IsReadOnly="True" Width="130" Text="{Binding Callsign}" ToolTip.Tip="Callsign"/>
          <TextBlock Text="TA" VerticalAlignment="Center" Width="35"/>
          <TextBox Focusable="False" IsReadOnly="True" Width="130" Text="{Binding RxTa}" ToolTip.Tip="Talkeralias"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="SRC" VerticalAlignment="Center" Width="35" />
          <TextBox Focusable="False" IsReadOnly="True" Width="130" Text="{Binding SrcId}" ToolTip.Tip="Source DMR-ID" />
          <TextBlock Text="DST" VerticalAlignment="Center" Width="35" />
          <TextBox Focusable="False" IsReadOnly="True" Width="130" Text="{Binding DstId}" ToolTip.Tip="Destination DMR-ID" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="RPT" VerticalAlignment="Center" Width="35" />
          <TextBox Focusable="False" IsReadOnly="True" Width="130" Text="{Binding RptId}" ToolTip.Tip="Repeater DMR-ID"/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- ListBox bleibt eigenständig, unabhängig von der Textfeld-Gruppe zentriert -->
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
      <ListBox x:Name="_listBoxLastHeard"
               BorderBrush="Gray"
               BorderThickness="1"
               CornerRadius="3"
               DoubleTapped="ListBoxLastHeard_DoubleTapped"
               FontFamily="Consolas" FontSize="12"
               Height="100"
               ItemsSource="{Binding LastHeard}"
               KeyDown="ListBoxLastHeard_OnKeyDown"
               Margin="0,10,0,0"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VerticalAlignment="Stretch"
               Width="400">

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="0"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="White"/>
          </Style>
          <Style Selector="ListBoxItem:nth-child(even)">
            <Setter Property="Background" Value="#F0F0F0"/>
          </Style>
          <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#D0E4FF"/>
          </Style>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
          </Style>
        </ListBox.Styles>

        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Clear List" Command="{Binding ClearLastHeardCommand}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ToolTip.Tip>
          <TextBlock Text="Last Heard (max. 50 Entries)"/>
        </ToolTip.Tip>
      </ListBox>
    </StackPanel>
    
  </StackPanel>
</UserControl>