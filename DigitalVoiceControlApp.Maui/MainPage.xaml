<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigitalVoiceControlApp.Maui.ViewModels"
             x:Class="DigitalVoiceControlApp.Maui.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="C# Digimodes">

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar mit Hamburger-Menü, Mode-Auswahl, Talkgroup/Reflektor-Auswahl und Connect/Disconnect -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" BackgroundColor="#E6F5F5" Padding="8" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="&#9776;"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    Clicked="OnMenuButtonClicked" />

            <!-- Mode-Auswahl: alle Werte aus Mode.cs; während der Verbindung gesperrt -->
            <Picker x:Name="ModePicker"
                    Grid.Column="1"
                    Title="Mode"
                    ItemsSource="{Binding ModeNames}"
                    SelectedItem="{Binding SelectedModeName}"
                    IsEnabled="{Binding IsModePickerEnabled}"
                    TextColor="Black"
                    TitleColor="#555555"
                    WidthRequest="90"
                    VerticalOptions="Center" />

            <!-- Platzhalter: Talkgroup-/Reflektorauswahl (Inhalt je nach Mode später per Code befüllt) -->
            <Picker x:Name="TalkgroupPicker"
                    Grid.Column="2"
                    Title="Talkgroup / Reflektor"
                    TextColor="Black"
                    TitleColor="#555555"
                    VerticalOptions="Center" />

            <!-- Connect/Disconnect: nur für DMR freigegeben (siehe MainPageViewModel.CanConnect) -->
            <Button x:Name="ConnectButton"
                    Grid.Column="3"
                    ImageSource="{Binding ConnectionIcon}"
                    BackgroundColor="{Binding ConnectionBackgroundColor}"
                    SemanticProperties.Description="{Binding ConnectionTooltip}"
                    ToolTipProperties.Text="{Binding ConnectionTooltip}"
                    WidthRequest="44"
                    HeightRequest="44"
                    Command="{Binding ConnectCommand}" />
        </Grid>

        <!-- Platzhalter für den restlichen Inhalt: zeigt vorerst Status und letzte Empfangsmeldung -->
        <VerticalStackLayout Grid.Row="1" Margin="16" Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="{Binding StatusText}" HorizontalTextAlignment="Center" FontSize="16" />
            <Label Text="{Binding RxText}" HorizontalTextAlignment="Center" FontSize="22" FontAttributes="Bold" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
