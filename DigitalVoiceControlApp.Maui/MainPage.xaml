<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalVoiceControlApp.Maui.MainPage"
             Title="Digital Voice Control">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Toolbar mit Hamburger-Menü -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" BackgroundColor="#E6F5F5" Padding="8">
            <Button Grid.Column="0"
                    Text="&#9776;"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    Clicked="OnMenuButtonClicked" />
        </Grid>

        <!-- Einfacher USB-Erkennungstest: nur "sehen wir den Stick?", ohne Permission/FTDI/Protokoll -->
        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="12">
            <Button x:Name="FindStickButton"
                    Text="USB-Geräte suchen"
                    Clicked="OnFindStickClicked"
                    HorizontalOptions="Fill" />

            <Label x:Name="UsbResultLabel"
                   Text="Noch nicht gesucht."
                   FontFamily="Consolas"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <!-- Platzhalter für den restlichen Inhalt -->
        <Label Grid.Row="2"
               Text="Hier kommt der Inhalt hin"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

    </Grid>
</ContentPage>
