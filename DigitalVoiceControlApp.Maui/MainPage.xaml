<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigitalVoiceControlApp.Maui.ViewModels"
             xmlns:views="clr-namespace:DigitalVoiceControlApp.Maui.Views"
             x:Class="DigitalVoiceControlApp.Maui.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title=".Net Digimodes">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Toolbar mit Hamburger-Menü, Mode-Auswahl, Talkgroup/Reflektor-Auswahl und Connect/Disconnect -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" BackgroundColor="#E6F5F5" Padding="8" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="&#9776;"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    Clicked="OnMenuButtonClicked" />

            <!-- Mode-Auswahl: alle Werte aus Mode.cs; während der Verbindung gesperrt -->
            <Picker x:Name="ModePicker"
                    Grid.Column="1"
                    Title="Mode"
                    ItemsSource="{Binding ModeNames}"
                    SelectedItem="{Binding SelectedModeName}"
                    IsEnabled="{Binding IsModePickerEnabled}"
                    TextColor="Black"
                    TitleColor="#555555"
                    WidthRequest="90"
                    VerticalOptions="Center" />

            <!-- Talkgroup-/Reflektorauswahl: im DMR-Mode die Talkgroups aus DmrTalkGroups.csv -->
            <Picker x:Name="TalkgroupPicker"
                    Grid.Column="2"
                    Title="{Binding LinkTargetTitle}"
                    ItemsSource="{Binding LinkTargetNames}"
                    SelectedItem="{Binding SelectedLinkTargetName}"
                    IsEnabled="{Binding IsLinkTargetPickerEnabled}"
                    TextColor="Black"
                    TitleColor="#555555"
                    VerticalOptions="Center" />

            <!-- Connect/Disconnect: nur für DMR freigegeben (siehe MainPageViewModel.CanConnect) -->
            <Button x:Name="ConnectButton"
                    Grid.Column="3"
                    ImageSource="{Binding ConnectionIcon}"
                    BackgroundColor="{Binding ConnectionBackgroundColor}"
                    SemanticProperties.Description="{Binding ConnectionTooltip}"
                    ToolTipProperties.Text="{Binding ConnectionTooltip}"
                    WidthRequest="44"
                    HeightRequest="44"
                    Command="{Binding ConnectCommand}" />
        </Grid>

        <!-- Statuszeile (zeigt auch, warum Connect gesperrt ist) -->
        <Label Grid.Row="1"
               Text="{Binding StatusText}"
               FontSize="12"
               TextColor="Gray"
               HorizontalTextAlignment="Center"
               Padding="8,4" />

        <!-- RX-Lautstärke und Mikrofon-Gain in dB (Bereich wie die Slider der Desktop-App: -40..+30), oberhalb der Felder -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto"
              Padding="12,4"
              ColumnSpacing="8"
              RowSpacing="2">

            <Label Grid.Row="0" Grid.Column="0" Text="&#128266;" FontSize="20" VerticalOptions="Center" />
            <Slider Grid.Row="0" Grid.Column="1"
                    Minimum="-40"
                    Maximum="30"
                    Value="{Binding RxVolume}"
                    DragCompleted="OnRxVolumeDragCompleted" />
            <Label Grid.Row="0" Grid.Column="2"
                   Text="{Binding RxVolume, StringFormat='{0:F0} dB'}"
                   WidthRequest="64"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center" />

            <Label Grid.Row="1" Grid.Column="0" Text="&#127908;" FontSize="20" VerticalOptions="Center" />
            <Slider Grid.Row="1" Grid.Column="1"
                    Minimum="-40"
                    Maximum="30"
                    Value="{Binding MicGain}"
                    DragCompleted="OnMicGainDragCompleted" />
            <Label Grid.Row="1" Grid.Column="2"
                   Text="{Binding MicGain, StringFormat='{0:F0} dB'}"
                   WidthRequest="64"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Mitte: die DMR-Ansicht (nur im DMR-Mode). Eigener Container, weil DmrView ein eigenes BindingContext bekommt. -->
        <Grid Grid.Row="3" IsVisible="{Binding IsDmrViewVisible}">
            <views:DmrView BindingContext="{Binding Dmr}" />
        </Grid>

        <!-- Unten: PTT. Einmal tippen = senden, nochmal tippen = Ende (nur im verbundenen DMR-Mode bedienbar) -->
        <Button Grid.Row="4"
                x:Name="PttButton"
                Text="{Binding PttText}"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="White"
                HeightRequest="64"
                Margin="12,8,12,12"
                BackgroundColor="{Binding PttBackgroundColor}"
                IsEnabled="{Binding IsPttEnabled}"
                Command="{Binding TogglePttCommand}" />

    </Grid>
</ContentPage>
