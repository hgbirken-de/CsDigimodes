<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigitalVoiceControlApp.Maui.ViewModels"
             xmlns:views="clr-namespace:DigitalVoiceControlApp.Maui.Views"
             x:Class="DigitalVoiceControlApp.Maui.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title=".Net Digimodes">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Toolbar mit Hamburger-Menü, Mode-Auswahl, Talkgroup/Reflektor-Auswahl und Connect/Disconnect -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" BackgroundColor="#E6F5F5" Padding="8" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="&#9776;"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    Clicked="OnMenuButtonClicked" />

            <!-- Mode-Auswahl: alle Werte aus Mode.cs; während der Verbindung gesperrt. Der Knopf sieht aus wie der
                 Reflektor-Knopf (umrandet) und öffnet eine Auswahlliste. -->
            <Button x:Name="ModeButton"
                    Grid.Column="1"
                    Text="{Binding SelectedModeName}"
                    Clicked="OnModeClicked"
                    IsEnabled="{Binding IsModePickerEnabled}"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    BorderColor="#808080"
                    BorderWidth="1"
                    FontSize="14"
                    Padding="4,0"
                    WidthRequest="54"
                    HeightRequest="44"
                    VerticalOptions="Center">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsModePickerEnabled}" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Reflektor und D-STAR-Modul in einer Zelle: Das Modul hat den Abstand als eigenen Rand, der entfällt mit ihm,
                 wenn es ausgeblendet ist. So bekommt der Reflektor außerhalb von D-STAR die volle Breite. -->
            <Grid Grid.Column="2" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <!-- Talkgroup-/Reflektorauswahl: Der Knopf zeigt den aktuellen Eintrag und öffnet die Auswahlseite mit Suchfeld
                     (im DMR-Mode die Talkgroups aus DmrTalkGroups.csv). Der Text wird in MainPage.xaml.cs gesetzt. -->
                <Button x:Name="LinkTargetButton"
                        Grid.Column="0"
                        Clicked="OnLinkTargetClicked"
                        IsEnabled="{Binding IsLinkTargetPickerEnabled}"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        BorderColor="#808080"
                        BorderWidth="1"
                        FontSize="14"
                        LineBreakMode="TailTruncation"
                        Padding="10,0"
                        HeightRequest="44"
                        VerticalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLinkTargetPickerEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- D-STAR-Modul (A-Z), rechts vom Reflektor: nur in den Modes DCS, REF und XRF bedienbar, und nur im getrennten Zustand -->
                <Button x:Name="ModuleButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Text="{Binding SelectedModule}"
                        Clicked="OnModuleClicked"
                        IsVisible="{Binding IsModulePickerVisible}"
                        IsEnabled="{Binding IsModulePickerEnabled}"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        BorderColor="#808080"
                        BorderWidth="1"
                        FontSize="14"
                        Padding="4,0"
                        WidthRequest="46"
                        HeightRequest="44"
                        VerticalOptions="Center">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsModulePickerEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Connect/Disconnect: nur für DMR freigegeben (siehe MainPageViewModel.CanConnect) -->
            <Button x:Name="ConnectButton"
                    Grid.Column="3"
                    ImageSource="{Binding ConnectionIcon}"
                    BackgroundColor="{Binding ConnectionBackgroundColor}"
                    BorderColor="#808080"
                    BorderWidth="1"
                    SemanticProperties.Description="{Binding ConnectionTooltip}"
                    ToolTipProperties.Text="{Binding ConnectionTooltip}"
                    WidthRequest="44"
                    HeightRequest="44"
                    Command="{Binding ConnectCommand}" />
        </Grid>

        <!-- Statuszeile (zeigt auch, warum Connect gesperrt ist) -->
        <Label Grid.Row="1"
               Text="{Binding StatusText}"
               FontSize="12"
               TextColor="Gray"
               HorizontalTextAlignment="Center"
               Padding="8,4" />

        <!-- RX-Lautstärke und Mikrofon-Gain in dB (Bereich wie die Slider der Desktop-App: -40..+30), oberhalb der Felder -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto"
              Padding="12,4"
              ColumnSpacing="8"
              RowSpacing="2">

            <Label Grid.Row="0" Grid.Column="0" Text="&#128266;" FontSize="20" VerticalOptions="Center" />
            <Slider Grid.Row="0" Grid.Column="1"
                    Minimum="-40"
                    Maximum="30"
                    Value="{Binding RxVolume}"
                    DragCompleted="OnRxVolumeDragCompleted" />
            <Label Grid.Row="0" Grid.Column="2"
                   Text="{Binding RxVolume, StringFormat='{0:F0} dB'}"
                   WidthRequest="64"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center" />

            <Label Grid.Row="1" Grid.Column="0" Text="&#127908;" FontSize="20" VerticalOptions="Center" />
            <Slider Grid.Row="1" Grid.Column="1"
                    Minimum="-40"
                    Maximum="30"
                    Value="{Binding MicGain}"
                    DragCompleted="OnMicGainDragCompleted" />
            <Label Grid.Row="1" Grid.Column="2"
                   Text="{Binding MicGain, StringFormat='{0:F0} dB'}"
                   WidthRequest="64"
                   HorizontalTextAlignment="End"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Mitte: die DMR-Ansicht (nur im DMR-Mode). Eigener Container, weil DmrView ein eigenes BindingContext bekommt. -->
        <Grid Grid.Row="3" IsVisible="{Binding IsDmrViewVisible}">
            <views:DmrView BindingContext="{Binding Dmr}" />
        </Grid>

        <!-- Mitte: die NXDN-Ansicht (nur im NXDN-Mode), im selben Bereich wie die DMR-Ansicht -->
        <Grid Grid.Row="3" IsVisible="{Binding IsNxdnViewVisible}">
            <views:NxdnView BindingContext="{Binding Nxdn}" />
        </Grid>

        <!-- Mitte: die Fusion-Ansicht (YSF, später FCS), im selben Bereich -->
        <Grid Grid.Row="3" IsVisible="{Binding IsFusionViewVisible}">
            <views:FusionView BindingContext="{Binding Fusion}" />
        </Grid>

        <!-- Mitte: die D-STAR-Ansicht (DCS, REF, XRF), im selben Bereich -->
        <Grid Grid.Row="3" IsVisible="{Binding IsDStarViewVisible}">
            <views:DStarView BindingContext="{Binding DStar}" />
        </Grid>

        <!-- Unten: PTT. Einmal tippen = senden, nochmal tippen = Ende (nur verbunden bedienbar) -->
        <Button Grid.Row="4"
                x:Name="PttButton"
                Text="{Binding PttText}"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="White"
                HeightRequest="64"
                Margin="12,8,12,12"
                BackgroundColor="{Binding PttBackgroundColor}"
                IsEnabled="{Binding IsPttEnabled}"
                Command="{Binding TogglePttCommand}" />

    </Grid>
</ContentPage>
