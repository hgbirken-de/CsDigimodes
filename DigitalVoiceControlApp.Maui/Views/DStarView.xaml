<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigitalVoiceControlApp.Maui.ViewModels"
             x:Class="DigitalVoiceControlApp.Maui.Views.DStarView"
             x:DataType="vm:DStarViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="12,8">

        <!-- Gruppierter Block wie in der Desktop-Ansicht: RPTR1/RPTR2, MYCALL/URCALL, Text, GPS -->
        <Border Grid.Row="0" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">

                <Label Grid.Row="0" Grid.Column="0" Text="RPTR1" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Rpt1}" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="2" Text="RPTR2" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="3" Text="{Binding Rpt2}" VerticalOptions="Center" />

                <Label Grid.Row="1" Grid.Column="0" Text="MYCALL" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Src}" FontAttributes="Bold" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="2" Text="URCALL" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="3" Text="{Binding Dst}" VerticalOptions="Center" />

                <Label Grid.Row="2" Grid.Column="0" Text="Text" VerticalOptions="Center" />
                <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Message}" LineBreakMode="TailTruncation" VerticalOptions="Center" />

                <Label Grid.Row="3" Grid.Column="0" Text="GPS" VerticalOptions="Center" />
                <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding GpsData}" LineBreakMode="TailTruncation" VerticalOptions="Center" />

            </Grid>
        </Border>

        <!-- Kopfzeile der Last-Heard-Liste -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Last Heard (max. 50 entries, double-tap copies the callsign)" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Clear" FontSize="12" Padding="10,0" HeightRequest="32" Command="{Binding ClearLastHeardCommand}" />
        </Grid>

        <!-- Last-Heard-Liste: keine Zeilenumbrüche, dafür waagerecht scrollbar (Breite = längste Zeile) -->
        <Border Grid.Row="2" Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="0">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                <CollectionView ItemsSource="{Binding LastHeard}" SelectionMode="None" WidthRequest="{Binding LastHeardWidth}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LastHeardItemDStar">
                            <Label Text="{Binding Display}" FontFamily="monospace" FontSize="12" Padding="8,5" LineBreakMode="NoWrap">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnLastHeardDoubleTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </Border>

    </Grid>
</ContentView>
